# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000

# MongoDB connection string. Local install or an Atlas cluster.
MONGODB_URI=mongodb://127.0.0.1:27017/lakshya

# Used to sign access tokens. Use a long random string in production.
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Primary AI provider. Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional fallback provider, used automatically if Gemini fails.
# Get a key from https://console.groq.com/keys
GROQ_API_KEY=

# Origin allowed to call this API. Comma-separate for multiple.
CLIENT_ORIGIN=http://localhost:5173
